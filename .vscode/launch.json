// A launch configuration that compiles the extension and then opens it inside a new window
{
    "version": "0.1.0",
    "configurations": [
        {
            "name": "Launch Extension: open a project",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                // The project folder to try the extension on (asked at start).
                "${input:projectFolder}",
                // Separate settings: user settings like "files.associations" or
                // "window.openFoldersInNewWindow" would interfere with the test.
                "--user-data-dir=${workspaceFolder}/.vscode-test/dev-user-data",
                // Both claim .asm files and would compete with this extension.
                "--disable-extension=maziac.asm-code-lens",
                "--disable-extension=mborik.z80-macroasm",
                "--extensionDevelopmentPath=${workspaceFolder}"
            ],
            "sourceMaps": true,
            "outFiles": [ "${workspaceFolder}/out/extension.js" ],
            "preLaunchTask": "watch",
            "skipFiles": [
                "**/extensionHostProcess.js"
            ]
        },
        {
            "name": "Launch Extension",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                //"--disable-extensions",
                // Separate settings: user settings like "files.associations" or
                // "window.openFoldersInNewWindow" would interfere with the test.
                "--user-data-dir=${workspaceFolder}/.vscode-test/dev-user-data",
                // Both claim .asm files and would compete with this extension.
                "--disable-extension=maziac.asm-code-lens",
                "--disable-extension=mborik.z80-macroasm",
                "--extensionDevelopmentPath=${workspaceFolder}"
            ],
            "sourceMaps": true,
            "outFiles": [ "${workspaceFolder}/out/extension.js" ],
            "preLaunchTask": "watch",
            "skipFiles": [
                "**/extensionHostProcess.js"
            ]
        }
    ],
    "inputs": [
        {
            "id": "projectFolder",
            "type": "promptString",
            "description": "Folder of a sjasmplus project to open",
            "default": "C:/speccy/crux"
        }
    ]
}

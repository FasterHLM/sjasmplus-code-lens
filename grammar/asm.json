{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "sjasmplus",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#line-directive"
		},
		{
			"include": "#block-end-at-line-start"
		},
		{
			"include": "#macro-definition-by-label"
		},
		{
			"include": "#label-definition"
		},
		{
			"include": "#statement-separator"
		},
		{
			"include": "#statement"
		},
		{
			"include": "#operands"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"include": "#block-comment"
				},
				{
					"include": "#line-comment"
				}
			]
		},
		"block-comment": {
			"name": "comment.block.sjasmplus",
			"begin": "/\\*",
			"end": "\\*/",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.comment.begin.sjasmplus"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.comment.end.sjasmplus"
				}
			},
			"patterns": [
				{
					"include": "#block-comment"
				}
			]
		},
		"line-comment": {
			"patterns": [
				{
					"name": "comment.line.semicolon.sjasmplus",
					"begin": ";",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.comment.sjasmplus"
						}
					},
					"end": "$",
					"patterns": [
						{
							"include": "#dezog"
						}
					]
				},
				{
					"name": "comment.line.double-slash.sjasmplus",
					"begin": "//",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.comment.sjasmplus"
						}
					},
					"end": "$",
					"patterns": [
						{
							"include": "#dezog"
						}
					]
				}
			]
		},
		"dezog": {
			"match": "(?<![A-Za-z0-9_])(?i:wpmem|logpoint|assertion)(?![A-Za-z0-9_])",
			"name": "keyword.control.dezog.sjasmplus"
		},
		"strings": {
			"patterns": [
				{
					"include": "#string-double"
				},
				{
					"include": "#string-single"
				}
			]
		},
		"string-double": {
			"name": "string.quoted.double.sjasmplus",
			"begin": "\"",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.string.begin.sjasmplus"
				}
			},
			"end": "(\")([ZC](?![A-Za-z0-9_.!?#@]))?|$",
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.string.end.sjasmplus"
				},
				"2": {
					"name": "storage.modifier.string-suffix.sjasmplus"
				}
			},
			"patterns": [
				{
					"match": "\\\\[\\\\?'\"0abdefnrtvABDEFNRTV]",
					"name": "constant.character.escape.sjasmplus"
				}
			]
		},
		"string-single": {
			"name": "string.quoted.single.sjasmplus",
			"begin": "'",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.string.begin.sjasmplus"
				}
			},
			"end": "(')(?!')([ZC](?![A-Za-z0-9_.!?#@]))?|$",
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.string.end.sjasmplus"
				},
				"2": {
					"name": "storage.modifier.string-suffix.sjasmplus"
				}
			},
			"patterns": [
				{
					"match": "''",
					"name": "constant.character.escape.apostrophe.sjasmplus"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"match": "(?<![A-Za-z0-9_.@$#])[0-9]+_[bBfF](?![A-Za-z0-9_!?#@$'])",
					"name": "variable.other.label.temporary.sjasmplus"
				},
				{
					"match": "(?<![A-Za-z0-9_.@$#])[0-9](?:['_]?[0-9A-Fa-f])*[hH](?![A-Za-z0-9_!?#@$'])",
					"name": "constant.numeric.integer.hexadecimal.sjasmplus"
				},
				{
					"match": "(?<![A-Za-z0-9_.@$#])0[xX][0-9A-Fa-f](?:['_]?[0-9A-Fa-f])*(?![A-Za-z0-9_!?#@$'])",
					"name": "constant.numeric.integer.hexadecimal.sjasmplus"
				},
				{
					"match": "(?<![A-Za-z0-9_.@$#])[$#][0-9A-Fa-f](?:['_]?[0-9A-Fa-f])*(?![A-Za-z0-9_!?#@$'])",
					"name": "constant.numeric.integer.hexadecimal.sjasmplus"
				},
				{
					"match": "(?<![A-Za-z0-9_.@$#])0[bB][01](?:['_]?[01])*(?![A-Za-z0-9_!?#@$'])",
					"name": "constant.numeric.integer.binary.sjasmplus"
				},
				{
					"match": "(?<![A-Za-z0-9_.!?#@$)\\]])%[01](?:['_]?[01])*(?![A-Za-z0-9_!?#@$'])",
					"name": "constant.numeric.integer.binary.sjasmplus"
				},
				{
					"match": "(?<![A-Za-z0-9_.@$#])[01](?:['_]?[01])*[bB](?![A-Za-z0-9_!?#@$'])",
					"name": "constant.numeric.integer.binary.sjasmplus"
				},
				{
					"match": "(?<![A-Za-z0-9_.@$#])0[qQ][0-7](?:['_]?[0-7])*(?![A-Za-z0-9_!?#@$'])",
					"name": "constant.numeric.integer.octal.sjasmplus"
				},
				{
					"match": "(?<![A-Za-z0-9_.@$#])[0-7](?:['_]?[0-7])*[qQoO](?![A-Za-z0-9_!?#@$'])",
					"name": "constant.numeric.integer.octal.sjasmplus"
				},
				{
					"match": "(?<![A-Za-z0-9_.@$#])[0-9](?:['_]?[0-9])*(?:[dD]|\\.[0-9]+)?(?![A-Za-z0-9_!?#@$'])",
					"name": "constant.numeric.integer.decimal.sjasmplus"
				},
				{
					"match": "(?<![A-Za-z0-9_.@$#])[0-9][A-Za-z0-9_']*",
					"name": "invalid.illegal.numeric.sjasmplus"
				},
				{
					"match": "(?<![A-Za-z0-9_.@$#])(\\${2,4})(@?\\.?[A-Za-z_][A-Za-z0-9_.!?#@]*)",
					"captures": {
						"1": {
							"name": "keyword.operator.label-memory.sjasmplus"
						},
						"2": {
							"name": "variable.other.label.sjasmplus"
						}
					}
				},
				{
					"match": "(?<![A-Za-z0-9_.@$#])\\${1,4}(?![A-Za-z0-9_.!?#@$])",
					"name": "variable.language.location-counter.sjasmplus"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"match": "(?<![A-Za-z0-9_.@$#])(?=\\.?(?:[a-z][a-z0-9_]*|[A-Z][A-Z0-9_]*)(?![A-Za-z0-9_]))(?i:low|high|not|mod|shl|shr|and|xor|or|abs|norel|exist|sizeof|pair|u16)(?![A-Za-z0-9_.!?#@])",
					"name": "keyword.operator.word.sjasmplus"
				},
				{
					"match": ">>>|>>|<<",
					"name": "keyword.operator.bitwise.shift.sjasmplus"
				},
				{
					"match": "<\\?|>\\?",
					"name": "keyword.operator.arithmetic.minmax.sjasmplus"
				},
				{
					"match": "<=|>=|==|!=|<|>|=",
					"name": "keyword.operator.comparison.sjasmplus"
				},
				{
					"match": "&&|\\|\\||!",
					"name": "keyword.operator.logical.sjasmplus"
				},
				{
					"match": "\\.\\.",
					"name": "keyword.operator.concatenation.sjasmplus"
				},
				{
					"match": "[&|^~]",
					"name": "keyword.operator.bitwise.sjasmplus"
				},
				{
					"match": "[-+*/%]",
					"name": "keyword.operator.arithmetic.sjasmplus"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"match": "(\\{)(?:\\s*([bB])(?=\\s))?",
					"captures": {
						"1": {
							"name": "punctuation.section.braces.begin.sjasmplus"
						},
						"2": {
							"name": "keyword.operator.memory-read-byte.sjasmplus"
						}
					}
				},
				{
					"match": "\\}",
					"name": "punctuation.section.braces.end.sjasmplus"
				},
				{
					"match": "\\(",
					"name": "punctuation.section.parens.begin.sjasmplus"
				},
				{
					"match": "\\)",
					"name": "punctuation.section.parens.end.sjasmplus"
				},
				{
					"match": "\\[",
					"name": "punctuation.section.brackets.begin.sjasmplus"
				},
				{
					"match": "\\]",
					"name": "punctuation.section.brackets.end.sjasmplus"
				},
				{
					"match": ",,",
					"name": "punctuation.separator.multi-argument.sjasmplus"
				},
				{
					"match": ",",
					"name": "punctuation.separator.comma.sjasmplus"
				}
			]
		},
		"label-reference": {
			"patterns": [
				{
					"match": "(?<![A-Za-z0-9_.@$#])@?\\.[A-Za-z_][A-Za-z0-9_.!?#@]*",
					"name": "variable.other.label.local.sjasmplus"
				},
				{
					"match": "(?<![A-Za-z0-9_.@$#])@?[A-Za-z_][A-Za-z0-9_.!?#@]*",
					"name": "variable.other.label.sjasmplus"
				}
			]
		},
		"registers": {
			"patterns": [
				{
					"match": "(?<![A-Za-z0-9_.@$#])(?:af'|AF')",
					"name": "support.type.register.z80.sjasmplus"
				},
				{
					"match": "(?<![A-Za-z0-9_.@$#])(?:af|bc|de|hl|sp|ix|iy|AF|BC|DE|HL|SP|IX|IY)(?![A-Za-z0-9_.!?#@])",
					"name": "support.type.register.z80.sjasmplus"
				},
				{
					"match": "(?<![A-Za-z0-9_.@$#])(?:ixh|ixl|iyh|iyl|xh|xl|yh|yl|hx|lx|hy|ly|IXH|IXL|IYH|IYL|XH|XL|YH|YL|HX|LX|HY|LY)(?![A-Za-z0-9_.!?#@])",
					"name": "support.type.register.z80.undocumented.sjasmplus"
				},
				{
					"match": "(?<![A-Za-z0-9_.@$#])[abcdefhlirABCDEFHLIR](?![A-Za-z0-9_.!?#@])",
					"name": "support.type.register.z80.sjasmplus"
				}
			]
		},
		"conditions": {
			"match": "(?<![A-Za-z0-9_.@$#(])(?:nz|nc|po|pe|ns|NZ|NC|PO|PE|NS|[zcpmsZCPMS])(?![A-Za-z0-9_.!?#@'])(?=\\s*(?:[,:;]|//|/\\*|$))",
			"name": "constant.language.condition.z80.sjasmplus"
		},
		"expression": {
			"patterns": [
				{
					"include": "#block-comment"
				},
				{
					"include": "#strings"
				},
				{
					"include": "#numbers"
				},
				{
					"include": "#operators-word"
				},
				{
					"include": "#label-reference"
				},
				{
					"include": "#operators"
				},
				{
					"include": "#punctuation"
				}
			]
		},
		"operators-word": {
			"patterns": [
				{
					"match": "(?<![A-Za-z0-9_.@$#])(?=\\.?(?:[a-z][a-z0-9_]*|[A-Z][A-Z0-9_]*)(?![A-Za-z0-9_]))(?i:low|high|not|mod|shl|shr|and|xor|or|abs|norel|exist|sizeof|pair|u16)(?![A-Za-z0-9_.!?#@])",
					"name": "keyword.operator.word.sjasmplus"
				}
			]
		},
		"operands": {
			"patterns": [
				{
					"include": "#block-comment"
				},
				{
					"include": "#registers"
				},
				{
					"include": "#strings"
				},
				{
					"include": "#numbers"
				},
				{
					"include": "#operators-word"
				},
				{
					"include": "#label-reference"
				},
				{
					"include": "#operators"
				},
				{
					"include": "#punctuation"
				}
			]
		},
		"branch-operands": {
			"patterns": [
				{
					"include": "#conditions"
				},
				{
					"match": "(?<![A-Za-z0-9_.@$#])[0-9]+[bBfF](?![A-Za-z0-9_!?#@$'])",
					"name": "variable.other.label.temporary.sjasmplus"
				},
				{
					"include": "#operands"
				}
			]
		},
		"angle-argument": {
			"begin": "(?:\\G|(?<=,))\\s*(<)",
			"beginCaptures": {
				"1": {
					"name": "string.quoted.other.lt-gt.argument.sjasmplus punctuation.definition.string.begin.sjasmplus"
				}
			},
			"end": ">|$",
			"endCaptures": {
				"0": {
					"name": "string.quoted.other.lt-gt.argument.sjasmplus punctuation.definition.string.end.sjasmplus"
				}
			},
			"contentName": "string.quoted.other.lt-gt.argument.sjasmplus",
			"patterns": [
				{
					"match": "!.",
					"name": "constant.character.escape.sjasmplus"
				}
			]
		},
		"macro-arguments": {
			"patterns": [
				{
					"include": "#angle-argument"
				},
				{
					"match": "\\G\\s*(=)(?!=)",
					"captures": {
						"1": {
							"name": "keyword.operator.assignment.sjasmplus"
						}
					}
				},
				{
					"match": "(?:\\G|(?<=,))\\s*([A-Za-z_][A-Za-z0-9_!?]*)\\s*(=)(?!=)",
					"captures": {
						"1": {
							"name": "variable.parameter.macro.sjasmplus"
						},
						"2": {
							"name": "keyword.operator.assignment.sjasmplus"
						}
					}
				},
				{
					"include": "#operands"
				}
			]
		},
		"filename": {
			"patterns": [
				{
					"match": "\\G\\s*((<)[^>]*(>))",
					"captures": {
						"1": {
							"name": "string.quoted.other.lt-gt.include.sjasmplus"
						},
						"2": {
							"name": "punctuation.definition.string.begin.sjasmplus"
						},
						"3": {
							"name": "punctuation.definition.string.end.sjasmplus"
						}
					}
				},
				{
					"match": "\\G\\s*((?=[^\\s\"'<;,]*[./\\\\])[^\\s\"'<;]+)",
					"captures": {
						"1": {
							"name": "string.unquoted.filename.sjasmplus"
						}
					}
				}
			]
		},
		"statement": {
			"patterns": [
				{
					"include": "#dot-repeat"
				},
				{
					"include": "#lua-block"
				},
				{
					"include": "#conditional"
				},
				{
					"include": "#macro-definition"
				},
				{
					"include": "#repeat-block"
				},
				{
					"include": "#module"
				},
				{
					"include": "#struct"
				},
				{
					"include": "#define"
				},
				{
					"include": "#symbol-assignment"
				},
				{
					"include": "#data"
				},
				{
					"include": "#file-directive"
				},
				{
					"include": "#device"
				},
				{
					"include": "#savenex"
				},
				{
					"include": "#savetap-savecdt"
				},
				{
					"include": "#opt"
				},
				{
					"include": "#sldopt"
				},
				{
					"include": "#mmu"
				},
				{
					"include": "#display"
				},
				{
					"include": "#directive"
				},
				{
					"include": "#struct-member"
				},
				{
					"include": "#instruction-branch"
				},
				{
					"include": "#instruction"
				},
				{
					"include": "#macro-call"
				}
			]
		},
		"dot-repeat": {
			"patterns": [
				{
					"match": "(?<![A-Za-z0-9_.!?#@$])(\\.)([0-9]+)(?=\\s)",
					"captures": {
						"1": {
							"name": "keyword.control.directive.repeat.sjasmplus"
						},
						"2": {
							"name": "constant.numeric.integer.decimal.sjasmplus"
						}
					}
				},
				{
					"begin": "(?<![A-Za-z0-9_.!?#@$])(\\.)(\\()",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.directive.repeat.sjasmplus"
						},
						"2": {
							"name": "punctuation.section.parens.begin.sjasmplus"
						}
					},
					"end": "\\)|$",
					"endCaptures": {
						"0": {
							"name": "punctuation.section.parens.end.sjasmplus"
						}
					},
					"patterns": [
						{
							"begin": "\\(",
							"end": "\\)|$",
							"beginCaptures": {
								"0": {
									"name": "punctuation.section.parens.begin.sjasmplus"
								}
							},
							"endCaptures": {
								"0": {
									"name": "punctuation.section.parens.end.sjasmplus"
								}
							},
							"patterns": [
								{
									"include": "#expression"
								}
							]
						},
						{
							"include": "#expression"
						}
					]
				}
			]
		},
		"lua-block": {
			"begin": "(?<![A-Za-z0-9_.!?#@$])(@)?((?=\\.?(?:[a-z][a-z0-9_]*|[A-Z][A-Z0-9_]*)(?![A-Za-z0-9_]))(?i:\\.?lua))(?![A-Za-z0-9_.!?#@])(.*)$",
			"beginCaptures": {
				"1": {
					"name": "keyword.operator.macro-inhibit.sjasmplus"
				},
				"2": {
					"name": "keyword.control.directive.lua.sjasmplus"
				},
				"3": {
					"patterns": [
						{
							"match": "(?<![A-Za-z0-9_.!?#@$])(?=\\.?(?:[a-z][a-z0-9_]*|[A-Z][A-Z0-9_]*)(?![A-Za-z0-9_]))(?i:pass1|pass2|pass3|allpass)(?![A-Za-z0-9_.!?#@])",
							"name": "support.constant.lua-pass.sjasmplus"
						},
						{
							"include": "#comments"
						}
					]
				}
			},
			"end": "^\\s*(endlua|ENDLUA)(?![A-Za-z0-9_])",
			"endCaptures": {
				"1": {
					"name": "keyword.control.directive.lua.sjasmplus"
				}
			},
			"contentName": "meta.embedded.block.lua",
			"patterns": [
				{
					"include": "source.lua"
				},
				{
					"match": "--.*$",
					"name": "comment.line.double-dash.lua"
				}
			]
		},
		"conditional": {
			"patterns": [
				{
					"begin": "(?<![A-Za-z0-9_.!?#@$])(@)?((?=\\.?(?:[a-z][a-z0-9_]*|[A-Z][A-Z0-9_]*)(?![A-Za-z0-9_]))(?i:\\.?(?:elseif|ifn|if)))(?![A-Za-z0-9_.!?#@])",
					"beginCaptures": {
						"1": {
							"name": "keyword.operator.macro-inhibit.sjasmplus"
						},
						"2": {
							"name": "keyword.control.conditional.sjasmplus"
						}
					},
					"end": "(?=[:;]|//)|$",
					"patterns": [
						{
							"include": "#expression"
						}
					]
				},
				{
					"begin": "(?<![A-Za-z0-9_.!?#@$])(@)?((?=\\.?(?:[a-z][a-z0-9_]*|[A-Z][A-Z0-9_]*)(?![A-Za-z0-9_]))(?i:\\.?(?:ifndef|ifdef)))(?![A-Za-z0-9_.!?#@])(?:\\s+([A-Za-z_][A-Za-z0-9_.!?#@]*))?",
					"beginCaptures": {
						"1": {
							"name": "keyword.operator.macro-inhibit.sjasmplus"
						},
						"2": {
							"name": "keyword.control.conditional.sjasmplus"
						},
						"3": {
							"name": "variable.other.constant.define.sjasmplus"
